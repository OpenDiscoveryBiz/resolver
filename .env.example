APP_NAME=resolver
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

CACHE_STORE=array
QUEUE_CONNECTION=sync

OCTANE_SERVER=frankenphp

# docker-compose overrides for local stack — see README "Local stack (all services)"
PROVIDER_ROOT=https://root.opendiscovery.biz

RESOLVER_TTL_MIN=600
RESOLVER_TTL_MAX=43200
RESOLVER_TTL_DEFAULT=3600

USER_TTL=3600
